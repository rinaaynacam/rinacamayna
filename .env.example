# Bu dosyada sir bulunmaz. Gercek degerler .env.local veya sunucu paneline girilir.
APP_ENV=development
SITE_URL=http://localhost:3000
# Alan adi degisirse yalniz bu degeri ve production SITE_URL degerini ayni HTTPS origin ile guncelleyin.
# Sonda /, yol, sorgu veya HTTP kullanmayin. Ornek: https://yenialanadi.com
CANONICAL_SITE_URL=https://rinacamayna.com
INDEXING_ENABLED=false

# Yeni Rina development veritabani. UV veya production DB kullanmayin.
VERITABANI_URL=
PAYLOAD_GIZLI_ANAHTAR=

# local | r2; Netlify production ortaminda r2 kullanin.
MEDYA_DEPOLAMA=local
R2_HESAP_ID=
R2_KOVA_ADI=
R2_ERISIM_ANAHTARI=
R2_GIZLI_ANAHTAR=
# Ornek: https://media.yenialanadi.com veya R2 public development URL'si. Sonda / kullanmayin.
MEDYA_PUBLIC_URL=

# Google Business Profile yorum senkronizasyonu (isteğe bağlı).
# Google Cloud projesinde Business Profile API erişimi ve OAuth 2.0 onayı gerekir.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# WhatsApp numarasi CMS'de tutulur; burada ikinci kaynak yaratmayin.
# E-posta, SMTP ve Resend yapilandirmasi yoktur.
